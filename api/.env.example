# Copy to .env for local work. In production use: kuso env set git-happens api ANTHROPIC_API_KEY=... --secret
ANTHROPIC_API_KEY=
# Free alternative: key from https://aistudio.google.com/app/apikey (leave ANTHROPIC_API_KEY empty or set AI_PROVIDER=gemini)
GEMINI_API_KEY=
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional reasoning level: low reduces response latency for Gemini 3 models.
# GEMINI_THINKING_LEVEL=low
# Optional
# Reverse proxies in front of this server (each appends to X-Forwarded-For). Use 0 if it is exposed directly,
# otherwise anybody can dodge the rate limits by sending their own X-Forwarded-For header.
TRUST_PROXY_HOPS=1
# Daily ceilings that keep a leaked or abused endpoint from running up the bill
DAILY_LIMIT_PER_CLIENT=40
DAILY_LIMIT_TOTAL=400
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=8787
# Comma-separated list of browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080,https://git-happens.junioraccelerator.org
